{
  "uid": "taskflow-overview",
  "title": "TaskFlow Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "taskflow"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Outbox pending events",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "taskflow_outbox_pending_events",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "id": 2,
      "title": "Active jobs",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "sum(taskflow_worker_active_jobs)",
          "legendFormat": "active"
        }
      ]
    },
    {
      "id": 3,
      "title": "Healthy workers",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "count(taskflow_worker_heartbeat_age_seconds < 30) or vector(0)",
          "legendFormat": "workers"
        }
      ]
    },
    {
      "title": "Jobs in each stage (in progress)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "PENDING"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "QUEUED"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RUNNING"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RETRY_WAIT"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c98500"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "taskflow_jobs{status=\"PENDING\"}",
          "legendFormat": "PENDING"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "taskflow_jobs{status=\"QUEUED\"}",
          "legendFormat": "QUEUED"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "taskflow_jobs{status=\"RUNNING\"}",
          "legendFormat": "RUNNING"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "taskflow_jobs{status=\"RETRY_WAIT\"}",
          "legendFormat": "RETRY_WAIT"
        }
      ],
      "id": 4
    },
    {
      "title": "Finished jobs by outcome",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "SUCCEEDED"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#0ca30c"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "FAILED"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d03b3b"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "DEAD_LETTER"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ec835a"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CANCELLED"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#898781"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "valueMode": "text"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "taskflow_jobs{status=\"SUCCEEDED\"}",
          "legendFormat": "SUCCEEDED"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "taskflow_jobs{status=\"FAILED\"}",
          "legendFormat": "FAILED"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "taskflow_jobs{status=\"DEAD_LETTER\"}",
          "legendFormat": "DEAD_LETTER"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "taskflow_jobs{status=\"CANCELLED\"}",
          "legendFormat": "CANCELLED"
        }
      ],
      "id": 5
    },
    {
      "id": 6,
      "title": "Queue depth",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "sum by (queue) (taskflow_queue_depth)",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Submissions / s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "sum by (job_type) (rate(taskflow_jobs_submitted_total[1m]))",
          "legendFormat": "{{job_type}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Attempt outcomes / s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "sum by (outcome) (rate(taskflow_jobs_completed_total[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Execution duration (p50 / p95)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(taskflow_job_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(taskflow_job_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 10,
      "title": "Queue wait (p50 / p95)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(taskflow_queue_wait_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(taskflow_queue_wait_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 11,
      "title": "Retries / s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "sum by (job_type) (rate(taskflow_job_retries_total[5m]))",
          "legendFormat": "{{job_type}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "Worker heartbeat age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "taskflow_worker_heartbeat_age_seconds",
          "legendFormat": "{{worker_id}}"
        }
      ]
    },
    {
      "id": 13,
      "title": "Recovery actions",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 37,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "sum by (kind) (increase(taskflow_recovered_total[5m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 14,
      "title": "Outbox published / s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "rate(taskflow_outbox_published_total[1m])",
          "legendFormat": "published"
        }
      ]
    }
  ]
}