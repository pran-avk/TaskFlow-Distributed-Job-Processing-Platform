{
  "uid": "taskflow-overview",
  "title": "TaskFlow Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "taskflow"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Outbox pending events",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "taskflow_outbox_pending_events",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "id": 2,
      "title": "Active jobs",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "sum(taskflow_worker_active_jobs)",
          "legendFormat": "active"
        }
      ]
    },
    {
      "id": 3,
      "title": "Healthy workers",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "count(taskflow_worker_heartbeat_age_seconds < 30) or vector(0)",
          "legendFormat": "workers"
        }
      ]
    },
    {
      "id": 4,
      "title": "Queue depth",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "sum by (queue) (taskflow_queue_depth)",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Submissions / s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "sum by (job_type) (rate(taskflow_jobs_submitted_total[1m]))",
          "legendFormat": "{{job_type}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Attempt outcomes / s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "sum by (outcome) (rate(taskflow_jobs_completed_total[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Execution duration (p50 / p95)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(taskflow_job_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(taskflow_job_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 8,
      "title": "Queue wait (p50 / p95)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(taskflow_queue_wait_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(taskflow_queue_wait_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 9,
      "title": "Retries / s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "sum by (job_type) (rate(taskflow_job_retries_total[5m]))",
          "legendFormat": "{{job_type}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Worker heartbeat age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "taskflow_worker_heartbeat_age_seconds",
          "legendFormat": "{{worker_id}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "Recovery actions",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "sum by (kind) (increase(taskflow_recovered_total[5m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "Outbox published / s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "rate(taskflow_outbox_published_total[1m])",
          "legendFormat": "published"
        }
      ]
    }
  ]
}