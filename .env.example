# Copy to .env and fill in. Never commit .env.

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256

# Local development without Docker uses SQLite; Docker Compose overrides these.
DATABASE_URL=sqlite:///./taskflow.db
# DATABASE_URL=postgresql+psycopg://taskflow:taskflow@localhost:5432/taskflow
REDIS_URL=redis://localhost:6379/0

# Bearer token Prometheus uses to scrape /api/v1/metrics. Unset = endpoint disabled.
METRICS_TOKEN=dev-metrics-token

# Optional tuning (defaults shown)
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7
# RATE_LIMIT_SUBMIT_PER_MINUTE=60
# RATE_LIMIT_RETRY_PER_MINUTE=20
# MAX_REQUEST_BYTES=1048576
# MAX_PAYLOAD_BYTES=65536
# RETRY_BASE_DELAY_SECONDS=1
# RETRY_MAX_DELAY_SECONDS=300
# RETRY_JITTER_SECONDS=1
# WORKER_CONCURRENCY=4
# WORKER_LEASE_SECONDS=30
# WORKER_HEARTBEAT_INTERVAL_SECONDS=5
# WORKER_SHUTDOWN_GRACE_SECONDS=30
# METRICS_PORT=9101
# QUEUED_REDISPATCH_AFTER_SECONDS=300
# LOG_JSON=true
# LOG_LEVEL=INFO

# Docker Compose
# POSTGRES_PASSWORD=taskflow
# GRAFANA_ADMIN_PASSWORD=admin
